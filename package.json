{
  "name": "chatter",
  "version": "2.4.1",
  "description": "Manage messages on channels in a separate window using GMCP.",
  "scripts": {
    "build": "npx -y @gesslar/muddy",
    "watch": "npx -y @gesslar/muddy -w",
    "major": "npx -y @gesslar/muddy version major --package",
    "minor": "npx -y @gesslar/muddy version minor --package",
    "patch": "npx -y @gesslar/muddy version patch --package",
    "update": "npx -y npm-check-updates -u && npm install",
    "pr": "gt submit -p --ai"
  },
  "license": "0BSD",
  "devDependencies": {
    "@gesslar/muddy": "^3.3.0"
  }
}
